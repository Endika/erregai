{
  "name": "erregai",
  "version": "1.19.9",
  "description": "Nearby Spanish fuel stations with prices — offline-first PWA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type:check": "tsc --noEmit",
    "format": "prettier --write \"{src,tests}/**/*.{ts,json,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,json,css}\"",
    "lint": "eslint src tests --ext .ts --max-warnings 0",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "test": "vitest run",
    "test:run": "vitest run --passWithNoTests",
    "data:radars": "node scripts/build-radars.mjs",
    "data:services": "node scripts/build-services.mjs",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Endika Iglesias",
  "license": "MIT",
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "proj4": "^2.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
